<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Estatísticas — Bolão Copa 2026</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow+Condensed:wght@400;600;700&family=Barlow:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --verde:#00A86B; --verde-escuro:#007A4D; --amarelo:#F5C518;
    --azul:#0D2137; --azul-medio:#163554; --azul-claro:#1E4A7A;
    --branco:#F0F4F8; --cinza:#8A9BB0; --cinza-claro:#C8D6E5;
    --laranja:#FF6B35;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{
    background:var(--azul);color:var(--branco);font-family:'Barlow',sans-serif;min-height:100vh;
    background-image:
      radial-gradient(ellipse at 20% 10%,rgba(0,168,107,.12) 0%,transparent 50%),
      radial-gradient(ellipse at 80% 90%,rgba(245,197,24,.08) 0%,transparent 50%);
  }
  header{
    background:linear-gradient(135deg,var(--verde-escuro) 0%,var(--azul-medio) 60%,var(--azul) 100%);
    border-bottom:3px solid var(--amarelo);padding:2rem 1.5rem;text-align:center;
  }
  .header-badge{display:inline-block;background:var(--amarelo);color:var(--azul);font-family:'Bebas Neue',sans-serif;font-size:.85rem;letter-spacing:3px;padding:4px 16px;border-radius:2px;margin-bottom:1rem;}
  header h1{font-family:'Bebas Neue',sans-serif;font-size:clamp(2rem,7vw,4rem);letter-spacing:4px;line-height:.9;}
  header h1 span{color:var(--amarelo);}
  header p{margin-top:.75rem;color:var(--cinza-claro);font-family:'Barlow Condensed',sans-serif;font-size:1rem;letter-spacing:1px;}

  main{max-width:900px;margin:0 auto;padding:2rem 1rem 4rem;}

  .loading{text-align:center;padding:4rem;color:var(--cinza);font-family:'Barlow Condensed',sans-serif;}
  .loading .ball{font-size:3rem;animation:bounce 1s infinite alternate;}
  @keyframes bounce{to{transform:translateY(-16px)}}

  /* CARDS DE NÚMEROS */
  .big-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:16px;margin-bottom:2.5rem;}
  .big-stat{
    background:var(--azul-medio);border-radius:12px;padding:1.5rem;text-align:center;
    border:1px solid rgba(200,214,229,.1);
  }
  .big-stat-val{font-family:'Bebas Neue',sans-serif;font-size:3rem;color:var(--amarelo);line-height:1;}
  .big-stat-lbl{font-family:'Barlow Condensed',sans-serif;font-size:.78rem;letter-spacing:1.5px;color:var(--cinza);margin-top:4px;text-transform:uppercase;}

  /* SEÇÃO */
  .section{margin-bottom:2.5rem;}
  .section-title{
    font-family:'Bebas Neue',sans-serif;font-size:1.4rem;letter-spacing:2px;
    color:var(--verde);margin-bottom:1rem;display:flex;align-items:center;gap:.75rem;
  }
  .section-title::after{content:'';flex:1;height:1px;background:rgba(0,168,107,.2);}

  /* BARRA DE PROGRESSO */
  .bar-item{margin-bottom:10px;}
  .bar-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;}
  .bar-nome{font-family:'Barlow Condensed',sans-serif;font-size:.95rem;font-weight:600;color:var(--branco);}
  .bar-count{font-family:'Bebas Neue',sans-serif;font-size:1rem;color:var(--amarelo);}
  .bar-track{height:8px;background:rgba(200,214,229,.08);border-radius:4px;overflow:hidden;}
  .bar-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--verde),var(--amarelo));transition:width .6s ease;}

  /* GRID DE EXTRAS */
  .extras-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;}
  .extra-card{background:var(--azul-medio);border-radius:12px;padding:1.25rem;border:1px solid rgba(200,214,229,.1);}
  .extra-card-title{font-family:'Bebas Neue',sans-serif;font-size:1rem;letter-spacing:2px;color:var(--amarelo);margin-bottom:1rem;}

  /* PLACARES */
  .placares-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:12px;}
  .placar-card{
    background:var(--azul-medio);border-radius:10px;padding:1rem;text-align:center;
    border:1px solid rgba(200,214,229,.1);
  }
  .placar-val{font-family:'Bebas Neue',sans-serif;font-size:1.8rem;color:var(--amarelo);letter-spacing:2px;}
  .placar-count{font-family:'Barlow Condensed',sans-serif;font-size:.75rem;color:var(--cinza);letter-spacing:1px;margin-top:4px;}

  /* TABELA PARTICIPANTES */
  .tabela{width:100%;border-collapse:collapse;}
  .tabela th{font-family:'Barlow Condensed',sans-serif;font-size:.75rem;letter-spacing:2px;text-transform:uppercase;color:var(--cinza);padding:8px 12px;border-bottom:1px solid rgba(200,214,229,.1);text-align:left;}
  .tabela td{padding:10px 12px;font-family:'Barlow Condensed',sans-serif;font-size:.95rem;border-bottom:1px solid rgba(200,214,229,.05);}
  .tabela tr:hover td{background:rgba(255,255,255,.02);}
  .pos-badge{font-family:'Bebas Neue',sans-serif;font-size:1rem;color:var(--cinza);}

  .updated{text-align:center;font-family:'Barlow Condensed',sans-serif;font-size:.75rem;color:var(--cinza);letter-spacing:1px;margin-top:2rem;}

  .btn-atualizar{
    display:block;margin:0 auto 2rem;background:var(--verde);color:#fff;border:none;
    border-radius:6px;padding:10px 28px;font-family:'Barlow Condensed',sans-serif;
    font-weight:700;font-size:.9rem;letter-spacing:2px;cursor:pointer;transition:all .2s;
  }
  .btn-atualizar:hover{background:var(--verde-escuro);}

  .nav-links{display:flex;gap:12px;justify-content:center;margin-bottom:2rem;flex-wrap:wrap;}
  .nav-link{
    font-family:'Barlow Condensed',sans-serif;font-size:.85rem;letter-spacing:1px;
    color:var(--cinza);border:1px solid rgba(200,214,229,.2);border-radius:6px;
    padding:8px 18px;text-decoration:none;transition:all .2s;
  }
  .nav-link:hover{color:var(--branco);border-color:rgba(200,214,229,.5);}
</style>
</head>
<body>

<header>
  <div class="header-badge">📊 ESTATÍSTICAS</div>
  <h1>BOLÃO COPA <span>2026</span></h1>
  <p>Curiosidades e números do bolão</p>
</header>

<main>
  <div class="nav-links">
    <a href="https://henriquefeldman.github.io/bolao2026/" class="nav-link">⚽ Formulário</a>
    <a href="https://henriquefeldman.github.io/bolao2026/consulta-palpites.html" class="nav-link">🔍 Meus Palpites</a>
  </div>

  <button class="btn-atualizar" onclick="carregarEstatisticas()">🔄 Atualizar dados</button>

  <div id="conteudo">
    <div class="loading">
      <div class="ball">⚽</div>
      <br>Carregando estatísticas...
    </div>
  </div>
</main>

<script>
const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbweLyhR_mUB0HH0kHiKsrfC64RH0YJkI2xtKjbCi3Nr-oLlb9NbBDu1yhg3nkjSfUFfgg/exec';

async function carregarEstatisticas() {
  document.getElementById('conteudo').innerHTML = `
    <div class="loading"><div class="ball">⚽</div><br>Carregando estatísticas...</div>`;
  try {
    const resp = await fetch(`${SCRIPT_URL}?action=estatisticas`);
    const data = await resp.json();
    renderEstatisticas(data);
  } catch(e) {
    document.getElementById('conteudo').innerHTML = `
      <div style="text-align:center;padding:3rem;color:var(--laranja);font-family:'Barlow Condensed',sans-serif">
        ⚠️ Erro ao carregar. Tente novamente.
      </div>`;
  }
}

function barras(items, max) {
  return items.map((item, i) => {
    const pct = max > 0 ? Math.round((item.count / max) * 100) : 0;
    const medal = i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : `${i+1}º`;
    return `
    <div class="bar-item">
      <div class="bar-header">
        <span class="bar-nome">${medal} ${item.nome}</span>
        <span class="bar-count">${item.count} voto${item.count !== 1 ? 's' : ''}</span>
      </div>
      <div class="bar-track"><div class="bar-fill" style="width:${pct}%"></div></div>
    </div>`;
  }).join('');
}

function renderEstatisticas(d) {
  const maxCampeao    = d.campeoes[0]?.count    || 1;
  const maxArtilheiro = d.artilheiros[0]?.count || 1;
  const maxPart       = d.topParticipantes[0]?.total || 1;

  const dt = new Date(d.geradoEm).toLocaleString('pt-BR', {timeZone:'America/Sao_Paulo'});

  document.getElementById('conteudo').innerHTML = `

    <!-- NÚMEROS GRANDES -->
    <div class="big-stats">
      <div class="big-stat">
        <div class="big-stat-val">${d.totalParticipantes}</div>
        <div class="big-stat-lbl">Participantes</div>
      </div>
      <div class="big-stat">
        <div class="big-stat-val">${d.totalPalpites}</div>
        <div class="big-stat-lbl">Palpites confirmados</div>
      </div>
      <div class="big-stat">
        <div class="big-stat-val">${d.campeoes.length}</div>
        <div class="big-stat-lbl">Times apostados como campeão</div>
      </div>
      <div class="big-stat">
        <div class="big-stat-val">${d.artilheiros.length}</div>
        <div class="big-stat-lbl">Artilheiros apostados</div>
      </div>
    </div>

    <!-- PLACARES MAIS APOSTADOS -->
    <div class="section">
      <div class="section-title">⚽ Placares Mais Apostados</div>
      <div class="placares-grid">
        ${d.topPlacares.map((p, i) => `
          <div class="placar-card">
            <div class="placar-val">${p.placar.replace('-',' × ')}</div>
            <div class="placar-count">${p.count} vez${p.count !== 1 ? 'es' : ''}</div>
          </div>`).join('')}
      </div>
    </div>

    <!-- CAMPEÃO E ARTILHEIRO -->
    <div class="extras-grid" style="margin-bottom:2.5rem">
      <div class="extra-card">
        <div class="extra-card-title">🥇 Quem vai ser Campeão?</div>
        ${barras(d.campeoes.slice(0,8), maxCampeao)}
      </div>
      <div class="extra-card">
        <div class="extra-card-title">⚽ Quem vai ser Artilheiro?</div>
        ${barras(d.artilheiros.slice(0,8), maxArtilheiro)}
      </div>
    </div>

    <!-- VICE, 3º E 4º -->
    <div class="extras-grid" style="margin-bottom:2.5rem">
      <div class="extra-card">
        <div class="extra-card-title">🥈 Vice-Campeão</div>
        ${barras(d.vices.slice(0,6), d.vices[0]?.count || 1)}
      </div>
      <div class="extra-card">
        <div class="extra-card-title">🥉 Terceiro Colocado</div>
        ${barras(d.terceiros.slice(0,6), d.terceiros[0]?.count || 1)}
      </div>
      <div class="extra-card">
        <div class="extra-card-title">4️⃣ Quarto Colocado</div>
        ${barras(d.quartos.slice(0,6), d.quartos[0]?.count || 1)}
      </div>
    </div>

    <!-- TOP PARTICIPANTES -->
    <div class="section">
      <div class="section-title">🏅 Mais Ativos — Palpites Confirmados</div>
      <table class="tabela">
        <thead>
          <tr>
            <th>#</th>
            <th>Participante</th>
            <th>Grupo</th>
            <th>Palpites</th>
          </tr>
        </thead>
        <tbody>
          ${d.topParticipantes.map((p, i) => `
            <tr>
              <td class="pos-badge">${i===0?'🥇':i===1?'🥈':i===2?'🥉':`${i+1}º`}</td>
              <td>${p.nome}</td>
              <td style="color:var(--amarelo)">${p.codigos || '—'}</td>
              <td style="font-family:'Bebas Neue',sans-serif;font-size:1.2rem;color:var(--verde)">${p.total}</td>
            </tr>`).join('')}
        </tbody>
      </table>
    </div>

    <div class="updated">Atualizado em ${dt} · Horário de Brasília</div>
  `;
}

// Carrega automaticamente ao abrir
carregarEstatisticas();
</script>
</body>
</html>
